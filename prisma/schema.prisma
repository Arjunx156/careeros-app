// CareerOS — Prisma Schema
// PostgreSQL via Neon. Source of truth: docs/05_Backend_Schema.md
//
// Single-user deployment: every row still carries userId so the model stays
// multi-user-capable, but the app resolves it to one seeded user (see lib/db/user.ts).

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────

enum WorkType {
  remote
  hybrid
  onsite
}

enum ApplicationStatus {
  wishlist
  preparing
  applied
  recruiter_screen
  interview
  final_round
  offer
  rejected
  withdrawn
}

enum ApplicationMethod {
  direct
  linkedin
  referral
  recruiter
  job_board
  other
}

enum ApplicationOutcome {
  hired
  rejected
  withdrew
  ghosted
}

enum AnalysisStatus {
  pending
  processing
  complete
  failed
}

enum RequirementStatus {
  strong
  partial
  missing
}

enum RecruiterVerdict {
  strong
  potential
  weak
}

enum InterviewStage {
  phone_screen
  technical
  case_study
  panel
  final
  offer
}

enum InterviewOutcome {
  passed
  failed
  pending
  cancelled
}

enum TimelineEventType {
  status_change
  note_added
  interview_scheduled
  message_sent
  follow_up_done
  created
  analysis_linked
}

enum RelationshipStatus {
  not_contacted
  connection_requested
  connected
  message_sent
  replied
  referral_requested
  referral_received
  interview_referral
  follow_up_required
}

enum ReferralStatus {
  none
  requested
  received
}

enum MessageType {
  connection_request
  after_connection
  recruiter
  hiring_manager
  follow_up
  other
}

enum MessageStatus {
  draft
  sent
  replied
  no_response
}

enum FollowUpType {
  application
  contact
}

enum FollowUpStatus {
  pending
  done
  snoozed
  rescheduled
}

// ─── USER ────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  resumes          ResumeVersion[]
  jobDescriptions  JobDescription[]
  analyses         Analysis[]
  applications     Application[]
  interviews       Interview[]
  timelineEvents   TimelineEvent[]
  contacts         Contact[]
  messages         Message[]
  followUps        FollowUp[]
  optimizedResumes OptimizedResume[]

  @@map("users")
}

// ─── RESUME VERSIONS ─────────────────────────────────────────────────────────

model ResumeVersion {
  id              String  @id @default(cuid())
  userId          String  @map("user_id")
  name            String
  targetRole      String? @map("target_role")
  targetIndustry  String? @map("target_industry")
  isMaster        Boolean @default(false) @map("is_master")
  versionNumber   Int     @default(1) @map("version_number")

  // Vercel Blob: url is public-read, pathname is the delete handle.
  fileUrl         String  @map("file_url")
  filePathname    String  @map("file_pathname")
  fileSizeBytes   Int?    @map("file_size_bytes")

  extractedText   String? @map("extracted_text")
  skills          String[]
  experienceYears Int?    @map("experience_years")
  educationLevel  String? @map("education_level")
  summaryCurrent  String? @map("summary_current")
  notes           String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  analyses         Analysis[]
  applications     Application[]
  optimizedResumes OptimizedResume[]

  @@index([userId])
  @@index([userId, isMaster])
  @@index([userId, createdAt])
  @@map("resume_versions")
}

// ─── JOB DESCRIPTIONS ────────────────────────────────────────────────────────

model JobDescription {
  id              String    @id @default(cuid())
  userId          String    @map("user_id")
  company         String
  role            String
  location        String?
  country         String?
  workType        WorkType? @map("work_type")
  jobUrl          String?   @map("job_url")
  salaryMin       Int?      @map("salary_min")
  salaryMax       Int?      @map("salary_max")
  salaryCurrency  String?   @default("EUR") @map("salary_currency")
  jdText          String    @map("jd_text")
  industry        String?
  roleCategory    String?   @map("role_category")
  deadline        DateTime?
  dateFound       DateTime  @default(now()) @map("date_found")
  requiredSkills  String[]  @map("required_skills")
  preferredSkills String[]  @map("preferred_skills")
  notes           String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  analyses     Analysis[]
  applications Application[]

  @@index([userId])
  @@index([userId, company])
  @@index([userId, dateFound])
  @@map("job_descriptions")
}

// ─── ANALYSES ────────────────────────────────────────────────────────────────
// Written incrementally by the staged pipeline (lib/ai/pipeline.ts).
// Every result column is nullable until the stage that produces it completes.

model Analysis {
  id               String @id @default(cuid())
  userId           String @map("user_id")
  resumeVersionId  String @map("resume_version_id")
  jobDescriptionId String @map("job_description_id")

  // Pipeline control
  status     AnalysisStatus @default(pending)
  stage      Int            @default(0)
  stageError String?        @map("stage_error")

  // Overall + sub-scores (stage: score)
  overallScore           Int? @map("overall_score")
  experienceScore        Int? @map("experience_score")
  skillsScore            Int? @map("skills_score")
  keywordAtsScore        Int? @map("keyword_ats_score")
  responsibilityScore    Int? @map("responsibility_score")
  industryScore          Int? @map("industry_score")
  seniorityScore         Int? @map("seniority_score")
  educationScore         Int? @map("education_score")
  quantificationScore    Int? @map("quantification_score")
  recruiterReadability   Int? @map("recruiter_readability")
  overallRecruiterAppeal Int? @map("overall_recruiter_appeal")

  // JD extraction (stage: extract)
  mustHaveRequirements    Json? @map("must_have_requirements")
  niceToHaveRequirements  Json? @map("nice_to_have_requirements")
  responsibilities        Json?
  softSkills              Json? @map("soft_skills")
  educationRequirements   Json? @map("education_requirements")
  experienceRequirements  Json? @map("experience_requirements")

  // Gap analysis (stage: gaps)
  gaps Json?

  // Bullet analysis (stage: bullets)
  bulletAnalysis Json? @map("bullet_analysis")

  // Keywords (stage: keywords)
  keywordsPresent  String[] @map("keywords_present")
  keywordsMissing  String[] @map("keywords_missing")
  keywordsOverused String[] @map("keywords_overused")

  // ATS (stage: ats)
  atsScore  Int?  @map("ats_score")
  atsIssues Json? @map("ats_issues")

  // Recruiter 10-second test (stage: recruiter)
  recruiterVerdict       RecruiterVerdict? @map("recruiter_verdict")
  recruiterVerdictReason String?           @map("recruiter_verdict_reason")
  recruiterAnswers       Json?             @map("recruiter_answers")

  // Action plan (stage: action_plan)
  actionPlan Json? @map("action_plan")

  // Summary (stage: summary)
  currentSummary     String? @map("current_summary")
  recommendedSummary String? @map("recommended_summary")
  summaryWhyBetter   String? @map("summary_why_better")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeVersion    ResumeVersion     @relation(fields: [resumeVersionId], references: [id], onDelete: Cascade)
  jobDescription   JobDescription    @relation(fields: [jobDescriptionId], references: [id], onDelete: Cascade)
  applications     Application[]
  optimizedResumes OptimizedResume[]

  @@index([userId])
  @@index([userId, createdAt])
  @@index([resumeVersionId])
  @@index([jobDescriptionId])
  @@map("analyses")
}

// ─── APPLICATIONS ────────────────────────────────────────────────────────────

model Application {
  id               String  @id @default(cuid())
  userId           String  @map("user_id")
  jobDescriptionId String? @map("job_description_id")
  resumeVersionId  String? @map("resume_version_id")
  analysisId       String? @map("analysis_id")

  // Job info
  company        String
  role           String
  location       String?
  country        String?
  workType       WorkType? @map("work_type")
  salaryMin      Int?      @map("salary_min")
  salaryMax      Int?      @map("salary_max")
  salaryCurrency String?   @default("EUR") @map("salary_currency")
  jobUrl         String?   @map("job_url")
  jdSnapshot     String?   @map("jd_snapshot")

  // Application info
  status            ApplicationStatus  @default(applied)
  applicationDate   DateTime?          @map("application_date")
  applicationMethod ApplicationMethod? @map("application_method")
  coverLetterUsed   Boolean            @default(false) @map("cover_letter_used")
  referralPerson    String?            @map("referral_person")

  // Contacts
  recruiterName         String? @map("recruiter_name")
  recruiterLinkedin     String? @map("recruiter_linkedin")
  recruiterEmail        String? @map("recruiter_email")
  hiringManagerName     String? @map("hiring_manager_name")
  hiringManagerLinkedin String? @map("hiring_manager_linkedin")
  contactId             String? @map("contact_id")

  // Tracking
  matchScore       Int?                @map("match_score")
  nextFollowupDate DateTime?           @map("next_followup_date")
  rejectionReason  String?             @map("rejection_reason")
  outcome          ApplicationOutcome?

  notes String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobDescription JobDescription? @relation(fields: [jobDescriptionId], references: [id], onDelete: SetNull)
  resumeVersion  ResumeVersion?  @relation(fields: [resumeVersionId], references: [id], onDelete: SetNull)
  analysis       Analysis?       @relation(fields: [analysisId], references: [id], onDelete: SetNull)
  contact        Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  interviews     Interview[]
  timelineEvents TimelineEvent[]
  messages       Message[]
  followUps      FollowUp[]

  @@index([userId])
  @@index([userId, status])
  @@index([userId, company])
  @@index([userId, applicationDate])
  @@index([userId, nextFollowupDate])
  @@map("applications")
}

// ─── INTERVIEWS ──────────────────────────────────────────────────────────────

model Interview {
  id            String            @id @default(cuid())
  userId        String            @map("user_id")
  applicationId String            @map("application_id")
  stage         InterviewStage
  scheduledAt   DateTime?         @map("scheduled_at")
  durationMins  Int?              @map("duration_mins")
  format        String?
  interviewers  String[]
  notes         String?
  outcome       InterviewOutcome? @default(pending)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([applicationId])
  @@map("interviews")
}

// ─── TIMELINE EVENTS ─────────────────────────────────────────────────────────

model TimelineEvent {
  id            String            @id @default(cuid())
  userId        String            @map("user_id")
  applicationId String            @map("application_id")
  eventType     TimelineEventType @map("event_type")
  description   String
  oldValue      String?           @map("old_value")
  newValue      String?           @map("new_value")

  createdAt DateTime @default(now()) @map("created_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
  @@map("timeline_events")
}

// ─── CONTACTS ────────────────────────────────────────────────────────────────

model Contact {
  id                 String             @id @default(cuid())
  userId             String             @map("user_id")
  name               String
  company            String?
  position           String?
  linkedinUrl        String?            @map("linkedin_url")
  email              String?
  location           String?
  relationshipStatus RelationshipStatus @default(not_contacted) @map("relationship_status")
  howMet             String?            @map("how_met")
  targetCompany      String?            @map("target_company")
  targetRole         String?            @map("target_role")
  lastContactedAt    DateTime?          @map("last_contacted_at")
  nextFollowupDate   DateTime?          @map("next_followup_date")
  referralStatus     ReferralStatus?    @default(none) @map("referral_status")
  notes              String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages     Message[]
  followUps    FollowUp[]
  applications Application[]

  @@index([userId])
  @@index([userId, relationshipStatus])
  @@index([userId, nextFollowupDate])
  @@map("contacts")
}

// ─── MESSAGES ────────────────────────────────────────────────────────────────

model Message {
  id            String        @id @default(cuid())
  userId        String        @map("user_id")
  contactId     String?       @map("contact_id")
  applicationId String?       @map("application_id")
  type          MessageType
  platform      String?
  content       String
  sentAt        DateTime?     @map("sent_at")
  status        MessageStatus @default(draft)
  aiGenerated   Boolean       @default(true) @map("ai_generated")
  contextUsed   Json?         @map("context_used")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact     Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([contactId])
  @@index([applicationId])
  @@map("messages")
}

// ─── FOLLOW-UPS ──────────────────────────────────────────────────────────────

model FollowUp {
  id            String         @id @default(cuid())
  userId        String         @map("user_id")
  type          FollowUpType
  applicationId String?        @map("application_id")
  contactId     String?        @map("contact_id")
  dueDate       DateTime       @map("due_date")
  status        FollowUpStatus @default(pending)
  note          String?
  completedAt   DateTime?      @map("completed_at")
  snoozedUntil  DateTime?      @map("snoozed_until")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  contact     Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status, dueDate])
  @@map("follow_ups")
}

// ─── OPTIMIZED RESUMES ───────────────────────────────────────────────────────

model OptimizedResume {
  id              String  @id @default(cuid())
  userId          String  @map("user_id")
  analysisId      String  @map("analysis_id")
  resumeVersionId String  @map("resume_version_id")
  name            String
  content         Json
  pdfUrl          String? @map("pdf_url")
  pdfPathname     String? @map("pdf_pathname")
  docxUrl         String? @map("docx_url")
  docxPathname    String? @map("docx_pathname")

  createdAt DateTime @default(now()) @map("created_at")

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis      Analysis      @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  resumeVersion ResumeVersion @relation(fields: [resumeVersionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([analysisId])
  @@map("optimized_resumes")
}
